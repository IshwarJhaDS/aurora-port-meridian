# Copy this file to .env and fill in your keys. .env is git-ignored and the dev
# server refuses to serve dotfiles, so keys never reach the browser.
# Keys are only used by `npm run assets:*` on your machine, never by the game.

# ── Tripo (3D models) ─ https://platform.tripo3d.ai → API keys (starts with tsk_)
TRIPO_API_KEY=
# Optional tuning
# TRIPO_MODEL=v3.1-20260211          # or v3.0-20250812, v2.5-20250123
# TRIPO_TEXTURE_QUALITY=standard     # fast | standard | detailed | extreme (extra credits)
# TRIPO_FACE_LIMIT=                  # override every model's triangle budget
# TRIPO_CONCURRENCY=2
# TRIPO_TIMEOUT_MINUTES=20

# ── ElevenLabs (voices, ambience, music) ─ https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice ids: open a voice in your ElevenLabs Voice Library and copy its ID.
# Search the library for "Nepali" or "Indian English" for a local accent.
# Unset _2/_3 voices fall back to the base FEMALE / MALE voice.
ELEVENLABS_VOICE_FEMALE=        # Maya (organizer), women residents
ELEVENLABS_VOICE_FEMALE_2=      # Dr. Anjali, Junu
ELEVENLABS_VOICE_FEMALE_3=      # Rasmila
ELEVENLABS_VOICE_MALE=          # Laxman, Bikash, men residents
ELEVENLABS_VOICE_MALE_2=        # Tashi
ELEVENLABS_VOICE_MALE_3=        # Sanjay
# Optional tuning
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v2
# ELEVENLABS_MUSIC_MODEL=music_v1
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_CONCURRENCY=3
